server {
    listen 80;
    server_name wcfit.example.invalid;
    access_log off;
    error_log /var/log/nginx/error.log crit;
    location ^~ /.well-known/acme-challenge/ { root /var/www/wcfit-acme; }
    location / { return 301 https://$server_name$request_uri; }
}

server {
    listen 443 ssl;
    server_name wcfit.example.invalid;
    ssl_certificate /etc/letsencrypt/live/wcfit.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wcfit.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/error.log crit;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;

    # Arquivos aprovados, em diretórios imutáveis por versão. Ausência gera 404.
    location ~ "^/legal/[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9]+)?/(termos|privacidade)\.html$" {
        root /var/www/wcfit-legal;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
