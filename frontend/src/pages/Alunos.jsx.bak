import { useState, useEffect, useMemo } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import api from '../api';
import '../styles/styles.css';
import '../styles/aluno.css';
import '../styles/treinamento.css';

export default function Alunos() {
  const navigate = useNavigate();
  const [alunos, setAlunos] = useState([]);
  const [aluno, setAluno] = useState({
    nome: '',
    cpf: '',
    telefone: '',
    email: '',
    data_nascimento: '',
    status: 'ativo',
    contato_emergencia: '',
    anamnese: '',
  });
  const [editingId, setEditingId] = useState(null);
  const [erro, setErro] = useState('');
  const [sucesso, setSucesso] = useState('');
  const [carregando, setCarregando] = useState(false);

  // Modelos de Treino, Modalidades e Níveis
  const [modelosDisponiveis, setModelosDisponiveis] = useState([]);
  const [modalidades, setModalidades] = useState([]);
  const [niveis, setNiveis] = useState([]);
  const [selectedModelosIds, setSelectedModelosIds] = useState([]);

  // Filtros de busca de modelos
  const [filtroModalidade, setFiltroModalidade] = useState('');
  const [filtroNivel, setFiltroNivel] = useState('');
  const [buscaModelo, setBuscaModelo] = useState('');

  useEffect(() => {
    carregarAlunos();
    carregarAuxiliares();
  }, []);

  const carregarAlunos = async () => {
    try {
      const res = await api.get('/alunos');
      setAlunos(res.data || []);
    } catch {
      setErro('Erro ao carregar alunos.');
    }
  };

  const carregarAuxiliares = async () => {
    try {
      const [resModelos, resMod, resNiv] = await Promise.all([
        api.get('/modelos-treino').catch(() => ({ data: [] })),
        api.get('/modalidades').catch(() => ({ data: [] })),
        api.get('/niveis-dificuldade').catch(() => ({ data: [] })),
      ]);

      const rawModelos = Array.isArray(resModelos.data)
        ? resModelos.data
        : resModelos.data?.modelos || [];
      setModelosDisponiveis(
        rawModelos.filter((m) => m.ativo !== 0 && m.ativo !== false && m.status !== 'inativo')
      );
      setModalidades(Array.isArray(resMod.data) ? resMod.data : resMod.data?.modalidades || []);
      setNiveis(Array.isArray(resNiv.data) ? resNiv.data : resNiv.data?.niveis || []);
    } catch (e) {
      console.error('Erro ao carregar dados de treinamento:', e);
    }
  };

  const handleChange = (e) => {
    setAluno({ ...aluno, [e.target.name]: e.target.value });
  };

  const toggleModelo = (modeloId) => {
    setSelectedModelosIds((prev) =>
      prev.includes(modeloId) ? prev.filter((id) => id !== modeloId) : [...prev, modeloId]
    );
  };

  const removerModeloSelecionado = (modeloId) => {
    setSelectedModelosIds((prev) => prev.filter((id) => id !== modeloId));
  };

  const resetForm = () => {
    setEditingId(null);
    setSelectedModelosIds([]);
    setAluno({
      nome: '',
      cpf: '',
      telefone: '',
      email: '',
      data_nascimento: '',
      status: 'ativo',
      contato_emergencia: '',
      anamnese: '',
    });
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setErro('');
    setSucesso('');
    setCarregando(true);

    const payload = {
      ...aluno,
      modelos_ids: selectedModelosIds,
    };

    try {
      if (editingId) {
        await api.put(`/alunos/${editingId}`, payload);
        setSucesso('Aluno e modelos de treinamento atualizados com sucesso!');
      } else {
        await api.post('/alunos', payload);
        setSucesso('Aluno cadastrado e modelos atribuídos com sucesso!');
      }

      resetForm();
      carregarAlunos();
    } catch (err) {
      setErro(
        err.response?.data?.mensagem || err.response?.data?.erro || 'Erro ao salvar aluno.'
      );
    } finally {
      setCarregando(false);
    }
  };

  const editar = async (a) => {
    setAluno({
      nome: a.nome || '',
      cpf: a.cpf || '',
      telefone: a.telefone || '',
      email: a.email || '',
      data_nascimento: a.data_nascimento ? a.data_nascimento.split('T')[0] : '',
      status: a.status || 'ativo',
      contato_emergencia: a.contato_emergencia || '',
      anamnese: a.anamnese || '',
    });
    setEditingId(a.id);

    try {
      const res = await api.get(`/alunos/${a.id}/modelos-treino`);
      const modelosAluno = Array.isArray(res.data) ? res.data : res.data?.modelos || [];
      setSelectedModelosIds(modelosAluno.map((m) => m.id));
    } catch {
      setSelectedModelosIds([]);
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const excluir = async (id) => {
    if (!confirm('Deseja realmente excluir este aluno?')) return;
    try {
      await api.delete(`/alunos/${id}`);
      carregarAlunos();
      setSucesso('Aluno excluído com sucesso.');
    } catch (err) {
      setErro(err.response?.data?.mensagem || 'Erro ao excluir aluno.');
    }
  };

  const modelosFiltrados = useMemo(() => {
    return modelosDisponiveis.filter((m) => {
      if (filtroModalidade && String(m.modalidade_id) !== String(filtroModalidade)) return false;
      if (filtroNivel && String(m.nivel_id) !== String(filtroNivel)) return false;
      if (buscaModelo.trim()) {
        const termo = buscaModelo.toLowerCase();
        const nomeMatch = (m.nome || '').toLowerCase().includes(termo);
        const descMatch = (m.descricao || '').toLowerCase().includes(termo);
        const objMatch = (m.objetivo || '').toLowerCase().includes(termo);
        if (!nomeMatch && !descMatch && !objMatch) return false;
      }
      return true;
    });
  }, [modelosDisponiveis, filtroModalidade, filtroNivel, buscaModelo]);

  const modelosSelecionadosObjetos = useMemo(() => {
    return selectedModelosIds
      .map((id) => modelosDisponiveis.find((m) => m.id === id))
      .filter(Boolean);
  }, [selectedModelosIds, modelosDisponiveis]);

  return (
    <div className="page-container">
      <div className="page-header">
        <div>
          <h2>Alunos</h2>
          <p>Cadastro, gestão e atribuição de modelos de treinamento</p>
        </div>
        <Link to="/dashboard" className="btn-voltar">← Voltar</Link>
      </div>

      {erro && <div className="msg-erro">{erro}</div>}
      {sucesso && <div className="msg-sucesso">{sucesso}</div>}

      <div className="form-card">
        <h3>{editingId ? 'Editar Aluno' : 'Novo Aluno'}</h3>

        <form onSubmit={handleSubmit} className="form-grid">
          <div className="campo">
            <label>Nome Completo *</label>
            <input name="nome" type="text" value={aluno.nome} onChange={handleChange} required />
          </div>
          <div className="campo">
            <label>CPF</label>
            <input name="cpf" type="text" value={aluno.cpf} onChange={handleChange} placeholder="000.000.000-00" />
          </div>
          <div className="campo">
            <label>Telefone / WhatsApp</label>
            <input name="telefone" type="tel" value={aluno.telefone} onChange={handleChange} placeholder="(00) 00000-0000" />
          </div>
          <div className="campo">
            <label>E-mail</label>
            <input name="email" type="email" value={aluno.email} onChange={handleChange} placeholder="aluno@email.com" />
          </div>
          <div className="campo">
            <label>Data de Nascimento</label>
            <input name="data_nascimento" type="date" value={aluno.data_nascimento} onChange={handleChange} />
          </div>
          <div className="campo">
            <label>Status</label>
            <select name="status" value={aluno.status} onChange={handleChange}>
              <option value="ativo">Ativo</option>
              <option value="inativo">Inativo</option>
              <option value="inadimplente">Inadimplente</option>
            </select>
          </div>
          <div className="campo-full">
            <label>Contato de Emergência</label>
            <input
              name="contato_emergencia"
              type="text"
              value={aluno.contato_emergencia}
              onChange={handleChange}
              placeholder="Nome e telefone do responsável/contato"
            />
          </div>
          <div className="campo-full">
            <label>Anamnese e Observações de Saúde</label>
            <textarea
              name="anamnese"
              rows="3"
              value={aluno.anamnese}
              onChange={handleChange}
              placeholder="Histórico médico, restrições ortopédicas, cirurgias, medicamentos..."
            />
          </div>

          <div className="campo-full aluno-modelos-secao">
            <div className="aluno-modelos-header">
              <div>
                <h4>🏋️ Atribuição de Modelos de Treinamento</h4>
                <p>
                  Selecione um ou vários modelos compartilhados. O aluno terá acesso às divisões e exercícios atualizados em tempo real.
                </p>
              </div>
              <span className="treinamento-badge treinamento-badge--azul">
                {selectedModelosIds.length} modelo(s) selecionado(s)
              </span>
            </div>

            {modelosSelecionadosObjetos.length > 0 && (
              <div className="aluno-modelos-vinculados-box">
                <div className="aluno-modelos-vinculados-titulo">
                  Modelos Vinculados para Atribuição:
                </div>
                <div className="aluno-modelos-grid">
                  {modelosSelecionadosObjetos.map((m) => (
                    <div key={m.id} className="aluno-modelo-selecionado-card">
                      <div className="aluno-modelo-selecionado-info">
                        <div className="aluno-modelo-nome">{m.nome}</div>
                        <div className="aluno-modelo-meta">
                          {m.modalidade_nome || 'Geral'} • {m.nivel_nome || 'Intermediário'} •{' '}
                          {m.divisoes?.length || 0} divisão(ões)
                        </div>
                      </div>
                      <button
                        type="button"
                        onClick={() => removerModeloSelecionado(m.id)}
                        className="treinamento-btn treinamento-btn--perigo treinamento-btn--sm"
                        title="Remover modelo do aluno"
                      >
                        ✕
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div className="aluno-modelos-filtros">
              <div className="campo">
                <label>Filtrar Modalidade</label>
                <select value={filtroModalidade} onChange={(e) => setFiltroModalidade(e.target.value)}>
                  <option value="">Todas as modalidades</option>
                  {modalidades.map((mod) => (
                    <option key={mod.id} value={mod.id}>
                      {mod.nome}
                    </option>
                  ))}
                </select>
              </div>

              <div className="campo">
                <label>Filtrar Nível</label>
                <select value={filtroNivel} onChange={(e) => setFiltroNivel(e.target.value)}>
                  <option value="">Todos os níveis</option>
                  {niveis.map((niv) => (
                    <option key={niv.id} value={niv.id}>
                      {niv.nome}
                    </option>
                  ))}
                </select>
              </div>

              <div className="campo">
                <label>Pesquisar Modelos</label>
                <input
                  type="text"
                  placeholder="Buscar modelo por nome ou objetivo..."
                  value={buscaModelo}
                  onChange={(e) => setBuscaModelo(e.target.value)}
                />
              </div>
            </div>

            <div className="aluno-modelos-lista-box">
              {modelosFiltrados.length === 0 ? (
                <div className="aluno-modelos-dica">
                  Nenhum modelo de treino encontrado com os filtros selecionados.
                </div>
              ) : (
                <div className="aluno-modelos-grid">
                  {modelosFiltrados.map((m) => {
                    const jaSelecionado = selectedModelosIds.includes(m.id);
                    return (
                      <div
                        key={m.id}
                        onClick={() => toggleModelo(m.id)}
                        className={`aluno-modelo-opcao-card ${jaSelecionado ? 'ativo' : ''}`}
                      >
                        <div className="aluno-modelo-selecionado-info">
                          <div className="aluno-modelo-nome">{m.nome}</div>
                          <div className="aluno-modelo-meta">
                            <span>{m.modalidade_nome || 'Geral'}</span> •{' '}
                            <span>{m.nivel_nome || 'Intermediário'}</span>
                            {m.divisoes?.length > 0 && ` • ${m.divisoes.length} divs`}
                          </div>
                        </div>
                        <input
                          type="checkbox"
                          checked={jaSelecionado}
                          onChange={() => {}}
                          aria-label={`Selecionar modelo ${m.nome}`}
                        />
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            <div className="aluno-modelos-dica">
              Alunos podem ser cadastrados sem modelos e novos modelos podem ser atribuídos a qualquer momento.
            </div>
          </div>

          <div className="btn-grupo">
            <button type="submit" className="btn-salvar" disabled={carregando}>
              {carregando
                ? 'Salvando...'
                : editingId
                  ? 'Atualizar Aluno e Modelos'
                  : 'Cadastrar Aluno com Modelos'}
            </button>
            {editingId && (
              <button
                type="button"
                onClick={resetForm}
                className="btn-outline"
                style={{ background: '#6b7280', color: '#fff', borderColor: '#6b7280' }}
              >
                Cancelar
              </button>
            )}
          </div>
        </form>
      </div>

      <h3>Alunos Cadastrados</h3>
      {alunos.length === 0 ? (
        <div className="lista-vazia">Nenhum aluno cadastrado.</div>
      ) : (
        <table className="tabela">
          <thead>
            <tr>
              <th>Nome</th>
              <th>CPF</th>
              <th>Status</th>
              <th className="acao-col" style={{ minWidth: '220px' }}>
                Ações
              </th>
            </tr>
          </thead>
          <tbody>
            {alunos.map((a) => (
              <tr key={a.id}>
                <td>
                  <strong
                    style={{ cursor: 'pointer', color: '#2563eb' }}
                    onClick={() => navigate(`/alunos/${a.id}`)}
                    title="Ver ficha completa do aluno"
                  >
                    {a.nome}
                  </strong>
                </td>
                <td>{a.cpf || '-'}</td>
                <td>
                  <span className={`badge badge-${a.status}`}>{a.status}</span>
                </td>
                <td className="acao-col">
                  <button
                    onClick={() => navigate(`/alunos/${a.id}`)}
                    className="btn-icon"
                    style={{ color: '#2563eb', fontWeight: 600, marginRight: '8px' }}
                    title="Acessar Ficha, Modelos de Treino, Histórico e Acompanhamento"
                  >
                    📋 Ficha & Treinos
                  </button>
                  <button onClick={() => editar(a)} className="btn-icon" style={{ marginRight: '6px' }}>
                    Editar
                  </button>
                  <button onClick={() => excluir(a.id)} className="btn-icon" style={{ color: '#dc2626' }}>
                    Excluir
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  );
}