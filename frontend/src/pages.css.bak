/* ========================================
   PÁGINAS INTERNAS - Padrão IronControl
   Segue cores do login.css
   ======================================== */

.page-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.page-header h2 {
  margin: 0;
  font-size: 1.5rem;
  color: #111827;
}

.page-header p {
  margin: 0.25rem 0 0;
  color: #6b7280;
  font-size: 0.9rem;
}

.btn-novo {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.2rem;
  border: none;
  border-radius: 6px;
  background: #2563eb;
  color: #ffffff;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
}

.btn-novo:hover {
  background: #1d4ed8;
}

.btn-voltar {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 6px;
  background: #f1f5f9;
  color: #475569;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
}

.btn-voltar:hover {
  background: #e2e8f0;
}

/* Tabelas */
.tabela {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.tabela thead {
  background: #f8fafc;
  border-bottom: 2px solid #e2e8f0;
}

.tabela th {
  text-align: left;
  padding: 0.875rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.tabela td {
  padding: 0.875rem 1rem;
  font-size: 0.9rem;
  color: #334155;
  border-bottom: 1px solid #e2e8f0;
}

.tabela tr:last-child td {
  border-bottom: none;
}

.tabela tr:hover td {
  background: #f8fafc;
}

/* Badge de status */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
}

.badge-ativo {
  background: #dcfce7;
  color: #166534;
}

.badge-inativo {
  background: #f1f5f9;
  color: #64748b;
}

.badge-inadimplente {
  background: #fee2e2;
  color: #991b1b;
}

.badge-presente {
  background: #dcfce7;
  color: #166534;
}

.badge-vencido {
  background: #fee2e2;
  color: #991b1b;
}

.badge-cancelado {
  background: #f1f5f9;
  color: #64748b;
}

/* Formulário de cadastro/edição */
.form-card {
  background: #ffffff;
  padding: 2rem;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.form-card h3 {
  margin-top: 0;
  margin-bottom: 1.5rem;
  font-size: 1.25rem;
  color: #111827;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.campo-full {
  grid-column: 1 / -1;
}

.btn-salvar {
  margin-top: 1rem;
  padding: 0.7rem 1.5rem;
  border: none;
  border-radius: 6px;
  background: #2563eb;
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-salvar:hover {
  background: #1d4ed8;
}

.btn-salvar:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-cancelar {
  margin-left: 0.75rem;
  padding: 0.7rem 1.5rem;
  border: none;
  border-radius: 6px;
  background: #f1f5f9;
  color: #475569;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-cancelar:hover {
  background: #e2e8f0;
}

/* Mensagens */
.msg-erro {
  padding: 0.75rem;
  background: #fee2e2;
  color: #991b1b;
  border-radius: 6px;
  font-size: 0.875rem;
  margin-bottom: 1rem;
  text-align: center;
}

.msg-sucesso {
  padding: 0.75rem;
  background: #d1fae5;
  color: #065f46;
  border-radius: 6px;
  font-size: 0.875rem;
  margin-bottom: 1rem;
  text-align: center;
}

/* Cards de estatística */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: #ffffff;
  padding: 1.5rem;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  border-top: 4px solid #2563eb;
}

.stat-card h3 {
  margin: 0 0 0.5rem;
  font-size: 0.875rem;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-card .valor {
  font-size: 2rem;
  font-weight: 700;
  color: #1e293b;
}

.stat-card .sub {
  font-size: 0.8rem;
  color: #94a3b8;
  margin-top: 0.25rem;
}

/* Lista vazia */
.lista-vazia {
  text-align: center;
  padding: 3rem;
  color: #64748b;
}
