/* ==========================================================
   PÁGINA ALUNOS - WC FIT (Responsiva e Fluida)
   ========================================================== */

.page-container {
  width: 100%;
  max-width: 100% !important;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}

.page-header,
.msg-erro,
.msg-sucesso,
.form-card,
.tabela,
.lista-vazia {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin: 0 0 1.5rem 0 !important;
  padding: 0 !important;
  min-height: auto !important;
}

.page-header h2 {
  margin: 0;
}

.page-header p {
  margin: 0.25rem 0 0 0;
}

.form-card {
  background: var(--bg-card, #ffffff);
  padding: 1.75rem 2rem;
  border-radius: var(--radius, 12px);
  box-shadow: var(--shadow, 0 4px 12px rgba(15, 23, 42, 0.06));
  margin-bottom: 1.75rem;
}

/* Grid do Formulário e Ficha em colunas responsivas (funciona em <form> e <div>) */
.form-card .form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
  width: 100%;
}

/* Garante label sempre acima do input/select/textarea */
.form-grid .campo,
.form-grid .campo-full {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.4rem;
  width: 100%;
  min-width: 0;
}

.form-grid .campo label,
.form-grid .campo-full label {
  display: block;
  width: 100%;
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
}

.form-grid .campo input,
.form-grid .campo select,
.form-grid .campo-full input,
.form-grid .campo-full textarea {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* Campo de Anamnese e Emergência ocupando a largura total das colunas */
.form-grid .campo-full {
  grid-column: 1 / -1;
}

.form-grid .campo-full textarea {
  min-height: 110px;
  resize: vertical;
}

/* Seção de Atribuição de Modelos de Treinamento */
.aluno-modelos-secao {
  margin-top: 0.75rem;
  padding-top: 1.5rem;
  border-top: 2px dashed var(--border, #e2e8f0);
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 100%;
  min-width: 0;
}

.aluno-modelos-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.aluno-modelos-header h4 {
  margin: 0;
  font-size: 1.05rem;
  color: var(--text-heading, #0f172a);
}

.aluno-modelos-header p {
  margin: 0.25rem 0 0;
  font-size: 0.85rem;
  color: var(--text-muted, #64748b);
}

.aluno-modelos-vinculados-box {
  background: var(--bg-subtle, #f8fafc);
  padding: 1rem;
  border-radius: 10px;
  border: 1px solid var(--border, #e2e8f0);
}

.aluno-modelos-vinculados-titulo {
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 0.65rem;
  color: var(--text-body, #334155);
}

.aluno-modelos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 0.75rem;
  width: 100%;
}

.aluno-modelo-selecionado-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  background: var(--bg-card, #ffffff);
  padding: 0.7rem 0.85rem;
  border-radius: 8px;
  border: 1px solid var(--border, #cbd5e1);
  min-width: 0;
}

.aluno-modelo-selecionado-info {
  min-width: 0;
  flex: 1;
}

.aluno-modelo-nome {
  font-weight: 600;
  font-size: 0.88rem;
  color: var(--text-heading, #0f172a);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.aluno-modelo-meta {
  font-size: 0.75rem;
  color: var(--text-muted, #64748b);
  margin-top: 0.2rem;
}

.aluno-modelos-filtros {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 0.75rem;
  width: 100%;
}

.aluno-modelos-lista-box {
  max-height: 240px;
  overflow-y: auto;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 10px;
  background: var(--bg-subtle, #f8fafc);
  padding: 0.65rem;
}

.aluno-modelo-opcao-card {
  border: 1px solid var(--border, #e2e8f0);
  background: var(--bg-card, #ffffff);
  border-radius: 8px;
  padding: 0.7rem 0.85rem;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.6rem;
  min-width: 0;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.aluno-modelo-opcao-card.ativo {
  border-color: #2563eb;
  background: #eff6ff;
}

.aluno-modelo-opcao-card.ativo .aluno-modelo-nome {
  color: #1d4ed8;
}

.aluno-modelos-dica {
  font-size: 0.78rem;
  color: var(--text-muted, #64748b);
}

/* Grupo de botões ocupando toda a linha inferior */
.form-card .btn-grupo {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 0.85rem;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border, #e2e8f0);
  width: 100%;
}

/* Título da listagem alinhado com o container */
.page-container > h3 {
  max-width: 100%;
  margin: 2rem 0 1rem;
}

/* Tabela de listagem ocupando largura total do container */
.tabela {
  width: 100%;
  border-collapse: collapse;
  background: var(--bg-card, #ffffff);
  border-radius: var(--radius, 12px);
  overflow: hidden;
  box-shadow: var(--shadow, 0 4px 12px rgba(15, 23, 42, 0.06));
  margin-top: 0.75rem;
}

[data-theme="dark"] .aluno-modelo-opcao-card.ativo {
  background: rgba(37, 99, 235, 0.18);
  border-color: #3b82f6;
}

[data-theme="dark"] .aluno-modelo-opcao-card.ativo .aluno-modelo-nome {
  color: #93c5fd;
}

/* Responsividade Mobile */
@media (max-width: 768px) {
  .form-card {
    padding: 1.25rem;
  }

  .form-card .form-grid,
  .aluno-modelos-grid,
  .aluno-modelos-filtros {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .form-card .btn-grupo {
    flex-direction: column;
  }

  .form-card .btn-grupo button {
    width: 100%;
  }

  .tabela {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
}